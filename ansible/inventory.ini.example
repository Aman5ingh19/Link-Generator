# =============================================================================
# Ansible Inventory Example: Remote Ubuntu/Debian Servers
# =============================================================================
# Copy this file to 'inventory.ini' and update the placeholders with your
# target server IP address and SSH credentials.
#
# DO NOT commit private keys or sensitive credentials to Git.
# =============================================================================

[app_servers]
# Replace 203.0.113.10 with your actual remote cloud server IP (e.g. AWS EC2, DigitalOcean, Hetzner, Linode)
webserver1 ansible_host=203.0.113.10 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa

[app_servers:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
