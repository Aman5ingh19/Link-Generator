# Database connection URL for Cloud-hosted MySQL (Aiven)
# Replace with your actual Aiven MySQL credentials
# Note: Aiven typically requires SSL (?ssl-mode=REQUIRED or ?sslaccept=strict)
DATABASE_URL="mysql://avnadmin:your_password_here@mysql-example-company.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED"

# Express server listening port
PORT=5000

# Zipkin distributed tracing HTTP collector endpoint
# In local development: http://localhost:9411/api/v2/spans
# In Docker Compose: http://zipkin:9411/api/v2/spans
ZIPKIN_ENDPOINT="http://localhost:9411/api/v2/spans"

# Frontend URL for CORS authorization
FRONTEND_URL="http://localhost:5173"
