# ========================================================
# One-Time Link Generator - Environment Configuration
# ========================================================

# Cloud-hosted MySQL Database (Aiven)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?ssl-mode=REQUIRED
DATABASE_URL="mysql://avnadmin:your_password_here@mysql-example-company.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED"

# Express server listening port (defaults to 5000)
PORT=5000

# OpenTelemetry Zipkin HTTP span collector endpoint
# Local standalone: http://localhost:9411/api/v2/spans
# Docker Compose:   http://zipkin:9411/api/v2/spans
ZIPKIN_ENDPOINT="http://localhost:9411/api/v2/spans"
